# OpenRouter — get a key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override default model IDs
MODEL_FAST=anthropic/claude-haiku-4.5
MODEL_REASONER=anthropic/claude-opus-4.7

# Comma-separated alternatives shown in the in-app ModelPicker
MODEL_FAST_ALTERNATIVES=anthropic/claude-haiku-4.5,openai/gpt-5-mini
MODEL_REASONER_ALTERNATIVES=anthropic/claude-opus-4.7,openai/gpt-5,anthropic/claude-sonnet-4.6

# Where SQLite + uploaded files are stored
DB_PATH=./data/tprm.sqlite
DATA_DIR=./data
STORAGE_DIR=./storage

# Replace with a long random string before any non-local use
STORAGE_SECRET=change-me-to-a-long-random-string

# CORS / dev
CORS_ORIGINS=http://localhost:3000

# Tunables
FTS_TOPK=8
MAX_UPLOAD_MB=50

# Tells OpenRouter which app this traffic comes from (informational)
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=cyber-tprm-assessment
