# OpenRouter — get a key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override default model IDs
MODEL_FAST=anthropic/claude-haiku-4.5
MODEL_REASONER=anthropic/claude-opus-4.7

# Comma-separated alternatives offered per stage on the in-app Settings page (Model routing)
MODEL_FAST_ALTERNATIVES=anthropic/claude-haiku-4.5,openai/gpt-5-mini
MODEL_REASONER_ALTERNATIVES=anthropic/claude-opus-4.7,openai/gpt-5,anthropic/claude-sonnet-4.6

# Where SQLite + uploaded files are stored
DB_PATH=./data/tprm.sqlite
DATA_DIR=./data
STORAGE_DIR=./storage

# Replace with a long random string before any non-local use
STORAGE_SECRET=change-me-to-a-long-random-string

# Host ports the app is published on. Change these to run the app elsewhere,
# e.g. FRONTEND_PORT=8080. Containers still listen on 3000 (frontend) /
# 8000 (backend) internally, so nothing else needs to change.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# CORS / dev — must match the browser-facing frontend origin.
# In Docker this is derived automatically from FRONTEND_PORT (see docker-compose.yml);
# the value below is only used when running the backend outside Docker.
CORS_ORIGINS=http://localhost:3000

# Tunables
FTS_TOPK=8
MAX_UPLOAD_MB=50

# --- LLM output-token budget policy (defaults shown; all optional) ---
# Three tiers, sized per call kind:
#   small  — scoping turns, narratives
#   medium — per-finding detail, enumeration, per-control gap analysis, attestation
#   large  — extraction, cross-correlation, confirmation/merge, bundle gap
#            analysis, executive summary (dense synthesis)
# The budget bounds the model's hidden reasoning too (providers count thinking
# tokens against max_tokens, and reasoning models spend 70-85 % of their
# output on it), so each tier leaves room to think before writing.
# On truncation the router retries with a doubled budget up to
# LLM_TRUNCATION_RETRIES times, clamped at LLM_TRUNCATION_CAP and at the
# model's own catalogued output cap, then fails loudly so callers can split
# the work. Lowering any of these below the defaults is an accuracy
# regression (see CLAUDE.md). The cap is the only runaway guard on a looping
# generation — keep it below the model's absolute maximum rather than at it.
# NOTE: OpenRouter reserves credits for the full requested max_tokens up
# front (per in-flight call — several stages run 4-way concurrency), so keep
# a comfortable credit balance; a cap-ladder attempt reserves
# LLM_TRUNCATION_CAP tokens on its own.
LLM_BUDGET_SMALL=16384
LLM_BUDGET_MEDIUM=32768
LLM_BUDGET_LARGE=65536
LLM_TRUNCATION_CAP=128000
LLM_TRUNCATION_RETRIES=2
# Liveness-based limits (completions are streamed, so any model speed works):
# no bytes at all on the socket / no output or reasoning token while the
# connection is alive (off by default = equal to the ceiling: models that
# reason hidden look stuck for many minutes) / hard per-call ceiling.
# Lowering SILENCE or CALL_MAX below the defaults re-introduces speed-based
# failures on slow reasoning models.
LLM_CONNECT_TIMEOUT_S=30
LLM_STREAM_IDLE_S=180
LLM_CONTENT_SILENCE_S=3600
LLM_CALL_MAX_S=3600
# Background-task watchdog: cancel a task with no activity for IDLE_TIMEOUT
# seconds (must be >= LLM_STREAM_IDLE_S) or running longer than MAX_RUNTIME.
TASK_IDLE_TIMEOUT_S=600
TASK_MAX_RUNTIME_S=14400
# Reasoner-profile models must support at least this many output tokens; fast-profile
# models at least LLM_BUDGET_MEDIUM (checked against a local capability table at
# startup; unknown models warn only; the truncation ladder clamps at the model's cap).
LLM_MIN_MODEL_OUTPUT_CAP=128000
# Failure forensics. Every failed LLM call is summarised on model_call
# (per-attempt outcome, finish reasons, provider, generation id, output
# head/tail) and logged at WARNING; set a directory to also dump the complete
# output of every attempt of a failed call as JSON. Off by default.
# LLM_FAILURE_DUMP_DIR=./data/llm-failures
# Log level for the app's own loggers (uvicorn keeps its own).
LOG_LEVEL=INFO

# OpenRouter provider names never to route to (comma-separated; sent as
# provider.ignore). One model id is served by many hosts and a host whose
# content filter stops generation on security or data-residency text truncates
# the answer while reporting a normal stop — the router detects the native
# finish reason (`sensitive`, `content_filter`…), refuses to parse, retries
# once and then fails naming the provider; list it here to route around it.
OPENROUTER_PROVIDER_IGNORE=StreamLake

# Tells OpenRouter which app this traffic comes from (informational)
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=cyber-tprm-assessment

# --- Deployment / dev switches ---
# "dev" (default) or "production". Some dev-only switches are refused in production.
APP_ENV=dev
# Dev-only LLM response cache keyed by (model, messages, sampling params). Off by
# default. Serves stored responses instead of calling the model so unchanged
# pipeline stages cost nothing while iterating. Never active when
# APP_ENV=production; the benchmark refuses to measure against a backend that
# has it on (its /api/health reports llm_dev_cache=true).
LLM_DEV_CACHE=0
